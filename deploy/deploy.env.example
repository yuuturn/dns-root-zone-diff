# deploy/deploy.sh の設定例。
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy/deploy.env は gitignore されているため、環境ごとの接続先を
# リポジトリに commit せずに管理できる。同じ名前の環境変数が設定されて
# いる場合はそちらが優先される (例: VPS=other-host make deploy)。

# デプロイ先 VPS (必須)。ssh / scp に渡すホスト名または user@host。
VPS="vps1.osk.skr.yfujii.net"

# 以下は省略可能。未設定なら deploy.sh の既定値が使われる。
# BINARY="dns-root-diff"
# REMOTE_BIN="/usr/local/bin/dns-root-diff"
# SERVICE="dns-root-diff.service"
