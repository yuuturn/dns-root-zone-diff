[Unit]
Description=DNS Root Zone Change Notification
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dns-root-diff -config /etc/dns-root-diff/config.yaml
Restart=on-failure
RestartSec=30
User=dns-root-diff
Group=dns-root-diff
# データ保存先
StateDirectory=dns-root-diff
# トレース (OpenTelemetry) を送る場合は環境変数で有効化する (未設定なら無効)。
# 例:
#Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.example.com:4317
#Environment=OTEL_EXPORTER_OTLP_INSECURE=true
#Environment=OTEL_SERVICE_NAME=dns-root-diff
#Environment=OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# セキュリティ強化
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dns-root-diff /etc/dns-root-diff

[Install]
WantedBy=multi-user.target
